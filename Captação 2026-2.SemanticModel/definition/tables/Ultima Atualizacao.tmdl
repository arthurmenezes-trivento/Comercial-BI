table 'Ultima Atualizacao'
	lineageTag: 73d85487-de7a-4e99-a734-e46d1efc5d4e

	measure 'Data Hora Atualizacao Texto' =
			
			"Atualizado em: " &
			FORMAT(
			    MAX('Ultima Atualizacao'[Atualizado Em]),
			    "dd/mm/yyyy HH:mm:ss"
			)
		lineageTag: a51001f0-6375-4f2e-a477-71f2d421d8ac

	column 'Atualizado Em'
		formatString: General Date
		lineageTag: ffdd81cf-5009-4841-9f75-0b48d0369584
		summarizeBy: none
		isNameInferred
		sourceColumn: [Atualizado Em]

		variation Variation
			isDefault
			relationship: 08e9ce5d-e85c-4f32-b468-b3b988ba6ede
			defaultHierarchy: LocalDateTable_dbc3bbb7-e54f-4a4e-8265-240590589075.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	partition 'Ultima Atualizacao' = calculated
