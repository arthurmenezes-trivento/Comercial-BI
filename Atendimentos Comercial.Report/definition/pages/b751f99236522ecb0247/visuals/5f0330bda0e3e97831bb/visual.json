    "objects": {
      "script": [
        {
          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'# -*- coding: utf-8 -*-\nimport matplotlib.pyplot as plt\nimport pandas as pd\n\ndf = dataset.copy()\n\ncol_data = df.columns[0]\ncol_legado = df.columns[1]\ncol_aging = df.columns[2]\ncol_valor = df.columns[-1]\n\ndf[col_data] = pd.to_datetime(df[col_data]).dt.strftime(\"%d/%m/%Y\")\n\npivot = (\n    df.groupby([col_data, col_legado, col_aging])[col_valor]\n      .sum()\n      .unstack([1,2], fill_value=0)\n      .reset_index()\n)\n\ncalc = pd.DataFrame({\"Data\": pivot[col_data]})\nestrutura=[]\n\nfor c in pivot.columns:\n    if c[0] != col_data:\n        nome=f\"{c[0]}_{c[1]}\"\n        calc[nome]=pivot[c]\n        estrutura.append((c[0], c[1], nome))\n\ncalc[\"Total no Dia\"]=calc.drop(columns=\"Data\").sum(axis=1)\n\nfinal=pd.DataFrame({\"Data\":calc[\"Data\"]})\nheader_top=[\"Data\"]\nheader_sub=[\"\"]\n\nfor legado, faixa, nome in estrutura:\n    final[nome]=calc[nome]\n    header_top.append(legado)\n    header_sub.append(str(faixa))\n\nfinal[\"Total no Dia\"]=calc[\"Total no Dia\"]\nheader_top.append(\"Total\")\nheader_sub.append(\"Total\")\n\ntot=final[\"Total no Dia\"].sum()\nlinha={\"Data\":\"Total\"}\nfor c in final.columns:\n    linha[c]=tot if c==\"Total no Dia\" else (linha[\"Data\"] if c==\"Data\" else final[c].sum())\nlinha[\"Data\"]=\"Total\"\n\nexib=pd.concat([final,pd.DataFrame([linha])],ignore_index=True)\n\ncell_text=[header_sub]+exib.values.tolist()\n\nfig,ax=plt.subplots(figsize=(12,6),dpi=200)\nax.axis(\"off\")\n\ntbl=ax.table(cellText=cell_text,colLabels=header_top,cellLoc=\"center\",bbox=[0,0,1,1])\n\ntbl.auto_set_font_size(False)\ntbl.set_fontsize(9)\n\nheader_bg=\"#1f4e78\"\nsub_bg=\"#2c6b9c\"\nalt=\"#f9fbfd\"\ntotal_bg=\"#e6eeea\"\n\nrows=len(cell_text)+1\ncols=len(header_top)\n\nprimeira={}\nfor i,h in enumerate(header_top):\n    if h not in (\"Data\",\"Total\") and h not in primeira:\n        primeira[h]=i\n\nfor (r,c),cell in tbl.get_celld().items():\n    cell.set_linewidth(.5)\n    cell.set_edgecolor(\"#cccccc\")\n    if r==0:\n        cell.set_facecolor(header_bg)\n        cell.set_text_props(color=\"white\",weight=\"bold\")\n        if c in primeira.values():\n            cell.get_text().set_text(header_top[c])\n        elif header_top[c] not in (\"Data\",\"Total\"):\n            cell.get_text().set_text(\"\")\n        else:\n            cell.get_text().set_text(header_top[c])\n    elif r==1:\n        cell.set_facecolor(sub_bg)\n        cell.set_text_props(color=\"white\",weight=\"bold\")\n    elif r==rows-1:\n        cell.set_facecolor(total_bg)\n        cell.set_text_props(weight=\"bold\",color=header_bg)\n    else:\n        cell.set_facecolor(alt if r%2==0 else \"white\")\n\nplt.tight_layout()\nplt.show()\n'"
                }
              }
            },
