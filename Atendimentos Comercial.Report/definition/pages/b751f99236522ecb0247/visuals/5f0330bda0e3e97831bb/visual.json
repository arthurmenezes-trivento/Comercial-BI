    "objects": {
      "script": [
        {
          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'import matplotlib.pyplot as plt\nimport pandas as pd\n\n# 1. Copia o dataset vindo do Power BI\ndf = dataset.copy()\n\n# 2. Mapeamento dinâmico por POSIÇÃO das colunas na lista de Valores:\ncol_data = df.columns[0]\ncol_legado = df.columns[1]\ncol_valor = df.columns[-1]\n\n# 3. Formatação da Data para dia/mês/ano (dd/mm/yyyy)\ndf[col_data] = pd.to_datetime(df[col_data]).dt.strftime(\"%d/%m/%Y\")\n\n# 4. Agrupamento dinâmico\ndf_pivot = (\n    df.groupby([col_data, col_legado])[col_valor]\n    .sum()\n    .unstack(fill_value=0)\n    .reset_index()\n)\n\n# Garantir que as categorias de Legado existam no pivot\nfor col in [\"Ciclo Atual\", \"Legado\"]:\n    if col not in df_pivot.columns:\n        df_pivot[col] = 0\n\n# 5. Cálculos dos Totais e Percentuais\ndf_pivot[\"Total no Dia\"] = df_pivot[\"Ciclo Atual\"] + df_pivot[\"Legado\"]\n\ndf_pivot[\"Ciclo Atual (%)\"] = (\n    df_pivot[\"Ciclo Atual\"] / df_pivot[\"Total no Dia\"]\n).fillna(0) * 100\ndf_pivot[\"Legado (%)\"] = (\n    df_pivot[\"Legado\"] / df_pivot[\"Total no Dia\"]\n).fillna(0) * 100\n\n# 6. Montagem do DataFrame Final\ndf_final = pd.DataFrame(\n    {\n        \"Data\": df_pivot[col_data],\n        \"Ciclo Atual (Qtd)\": df_pivot[\"Ciclo Atual\"],\n        \"Ciclo Atual (%)\": df_pivot[\"Ciclo Atual (%)\"].map(\"{:.1f}%\".format),\n        \"Legado (Qtd)\": df_pivot[\"Legado\"],\n        \"Legado (%)\": df_pivot[\"Legado (%)\"].map(\"{:.1f}%\".format),\n        \"Total no Dia\": df_pivot[\"Total no Dia\"],\n    }\n)\n\n# 7. Linha de Total Geral Dinâmico\ntot_c = df_pivot[\"Ciclo Atual\"].sum()\ntot_l = df_pivot[\"Legado\"].sum()\ntot_t = df_pivot[\"Total no Dia\"].sum()\n\npct_tot_c = f\"{(tot_c / tot_t * 100):.1f}%\" if tot_t > 0 else \"0.0%\"\npct_tot_l = f\"{(tot_l / tot_t * 100):.1f}%\" if tot_t > 0 else \"0.0%\"\n\nlinha_total = pd.DataFrame(\n    [\n        {\n            \"Data\": \"Total\",\n            \"Ciclo Atual (Qtd)\": tot_c,\n            \"Ciclo Atual (%)\": pct_tot_c,\n            \"Legado (Qtd)\": tot_l,\n            \"Legado (%)\": pct_tot_l,\n            \"Total no Dia\": tot_t,\n        }\n    ]\n)\n\ndf_exibicao = pd.concat([df_final, linha_total], ignore_index=True)\n\n# 8. Renderização sem corte de texto e totalmente responsiva\n# Mantenha um figsize proporcional como (12, 6)\nfig, ax = plt.subplots(figsize=(12, 6), dpi=200)\nax.axis(\"off\")\n\n# bbox=[0, 0, 1, 1] força a ocupação total no quadro do Power BI\ntable = ax.table(\n    cellText=df_exibicao.values,\n    colLabels=df_exibicao.columns,\n    cellLoc=\"center\",\n    loc=\"center\",\n    bbox=[0, 0, 1, 1],\n)\n\ntable.auto_set_font_size(False)\n\n# Tamanho de fonte ajustado por quantidade de dados para nunca cortar\nnum_linhas = len(df_exibicao)\nif num_linhas > 20:\n    tamanho_fonte = 8\nelif num_linhas > 10:\n    tamanho_fonte = 9\nelse:\n    tamanho_fonte = 11\n\ntable.set_fontsize(tamanho_fonte)\n\n# Estilização Visual e Prevenção de Reticências (...)\nheader_color = \"#1f4e78\"\ntotal_row_color = \"#e6eeea\"\nalt_row_color = \"#f9fbfd\"\n\nfor (row, col), cell in table.get_celld().items():\n    cell.set_linewidth(0.5)\n    cell.set_edgecolor(\"#cccccc\")\n\n    # Evita que o texto vire ''...'' ao impedir o clipping/corte\n    cell.get_text().set_clip_on(False)\n\n    if row == 0:\n        cell.set_facecolor(header_color)\n        cell.set_text_props(color=\"white\", weight=\"bold\")\n    elif row == len(df_exibicao):\n        cell.set_facecolor(total_row_color)\n        cell.set_text_props(weight=\"bold\", color=\"#1f4e78\")\n    else:\n        if row % 2 == 0:\n            cell.set_facecolor(alt_row_color)\n        else:\n            cell.set_facecolor(\"white\")\n\nplt.tight_layout()\nplt.show()'"
                }
              }
            },
