	partition dCalendario = calculated
		mode: import
		source =
				
				VAR DataInicial = DATE(2026,4,7)
				VAR DataFinal = DATE(2026,12,31)
				
				RETURN
				ADDCOLUMNS(
				    CALENDAR(DataInicial, DataFinal),
				
				    "Ano", YEAR([Date]),
				    "MesNumero", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "MesAno", FORMAT([Date], "MMM/YYYY"),
				    "Dia", DAY([Date]),
				    "DiaSemanaNumero", WEEKDAY([Date],2),
				    "DiaSemana", FORMAT([Date], "dddd"),
				    "DiaSemanaAbrev", FORMAT([Date], "ddd"),
				
				    "Semana",
				    VAR DataBase = DATE(2026,4,7)
				    VAR PrimeiraSegunda = DATE(2026,4,13)
				
				    VAR NumeroSemana =
				        IF(
				            [Date] < PrimeiraSegunda,
				            1,
				            INT(DATEDIFF(PrimeiraSegunda,[Date],DAY)/7) + 2
				        )
				
				    RETURN
				        "s" & FORMAT(NumeroSemana,"00"),
				
				    "PrimeiroDiaSemana",
				    VAR PrimeiraSegunda1 = DATE(2026,4,13)
				
				    VAR DataSemana =
				        IF(
				            [Date] < PrimeiraSegunda1,
				            DATE(2026,4,7),
				            [Date] - WEEKDAY([Date],2) + 1
				        )
				
				    RETURN
				        FORMAT(DataSemana,"dd/MM"),
				
				    "InicioFimSemana",
				    VAR PrimeiraSegunda2 = DATE(2026,4,13)
				
				    VAR InicioSemana =
				        IF(
				            [Date] < PrimeiraSegunda2,
				            DATE(2026,4,7),
				            [Date] - WEEKDAY([Date],2) + 1
				        )
				
				    VAR FimSemana =
				        IF(
				            [Date] < PrimeiraSegunda2,
				            DATE(2026,4,12),
				            InicioSemana + 6
				        )
				
				    RETURN
				        FORMAT(InicioSemana,"dd/MM/yy")
				        & " - " &
				        FORMAT(FimSemana,"dd/MM/yy"),
				
				    "MesFormatado",
				        FORMAT([Date],"MM") & "-" &
				        UPPER(LEFT(FORMAT([Date],"MMM"),3))
				)

	annotation PBI_Id = ac71d6a0a8154dea9cbf55558f90df05

