table Medidas
	lineageTag: 4419056a-db71-48c1-bdbb-d01910b4e999

	measure UltimoAtendente = ```
			
			VAR TabelaFiltrada = 
			    FILTER(
			        'Atendimentos',
			        'Atendimentos'[Assunto] <> "Alteração em Massa" &&
			        NOT(ISBLANK('Atendimentos'[Assunto]))
			        
			    )
			VAR DataMaisRecente = 
			    CALCULATE(
			        MAX('Atendimentos'[Data de Criação]),
			        TabelaFiltrada
			    )
			RETURN
			CALCULATE(
			    MAX('Atendimentos'[Criado por]),
			    TabelaFiltrada,
			    'Atendimentos'[Data de Criação] = DataMaisRecente
			)
			
			```
		lineageTag: c2990e0a-0c93-4df1-848b-3acbcbe83565

	measure 'data Ultimo Atendimento' = ```
			
			VAR TabelaFiltrada = 
			    FILTER(
			        'Atendimentos',
			        'Atendimentos'[Assunto] <> "Alteração em Massa" &&
			        NOT ISBLANK('Atendimentos'[Assunto])
			    )
			RETURN
			    CALCULATE(
			        -- Isola a linha com a data mais recente e concatena como texto
			        CONCATENATEX(
			            TOPN(
			                1,
			                'Atendimentos',
			                'Atendimentos'[Data de Criação], DESC,
			                'Atendimentos'[hora de Criação], DESC),
			            FORMAT('Atendimentos'[Data de Criação], "dd/mm/yyyy") & " " & FORMAT('Atendimentos'[Hora de Criação], "hh:mm"),
			            " "
			        ),
			        TabelaFiltrada
			    )
			
			```
		lineageTag: 1f666bc8-5ee7-4469-85d1-44c98ed78c45

	measure UltimaDataHoraCriacaoProprietario = ```
			
			-- Step 1: Clean and standardize the full name
			VAR NomeCompleto = TRIM(LOWER(COALESCE(SELECTEDVALUE(Leads[Proprietário Lead]), "")))
			
			-- Step 2: Find the first space to extract only the first name
			VAR PosicaoEspaco = SEARCH(" ", NomeCompleto, 1, 0)
			VAR NomeProprietario = 
			    IF(
			        PosicaoEspaco > 0,
			        LEFT(NomeCompleto, PosicaoEspaco - 1),
			        NomeCompleto
			    )
			
			RETURN
			    IF(
			        NomeProprietario = "",
			        BLANK(),
			        CALCULATE(
			            -- Concatenamos a Data e a Hora da linha mais recente em formato de texto
			            CONCATENATEX(
			                TOPN(1, Atendimentos, Atendimentos[Data de Criação], DESC),
			                FORMAT(Atendimentos[Data de Criação], "dd/mm/yyyy") & " " & FORMAT(Atendimentos[Hora de Criação], "hh:mm"),
			                " "
			            ),
			            -- Mantemos o seu filtro de busca por nome
			            SEARCH(NomeProprietario, TRIM(LOWER(Atendimentos[Criado por])), 1, 0) > 0
			        )
			    )
			
			```
		lineageTag: 694999aa-e88d-4256-bce6-46893fa0a8d7

	measure 'Dias Sem Atendimento' = ```
			
			VAR TabelaFiltrada = 
			    FILTER(
			        'Atendimentos',
			        'Atendimentos'[Assunto] <> "Alteração em Massa" && 
			        NOT ISBLANK('Atendimentos'[Assunto])
			    )
			
			-- 1. Encontra a data e hora do último atendimento combinado
			VAR UltimoAtendimentoDT = 
			    CALCULATE(
			        MAXX(
			            TOPN(1, 'Atendimentos', 'Atendimentos'[Data de Criação], DESC, 'Atendimentos'[hora de Criação], DESC),
			            'Atendimentos'[Data de Criação] + 'Atendimentos'[Hora de Criação]
			        ),
			        TabelaFiltrada
			    )
			
			-- 2. Define o momento atual (pode usar UTCNOW() se seus dados forem em UTC)
			VAR DataAtual = NOW()
			
			-- 3. Calcula a diferença em dias (com casas decimais para precisão)
			VAR DiferencaDias = 
			    IF(
			        NOT ISBLANK(UltimoAtendimentoDT),
			        DATEDIFF(UltimoAtendimentoDT, DataAtual, DAY)
			    )
			
			RETURN
			    DiferencaDias
			
			```
		formatString: 0
		lineageTag: cfaacc72-d562-4ae0-99f6-f065b7b88504

	measure 'Matr 26-2' = ```
			
			    CALCULATE(
			        DISTINCTCOUNT('Leads'[ID Lead]),
			        'Leads'[Situação Inscrição] = "Matriculado",
			        'Leads'[Data de Pagamento] <> BLANK(),
			        USERELATIONSHIP(dCalendario[Date], Leads[Data Criacao])
			    )
			```
		formatString: 0
		lineageTag: 776476a4-d45f-4e8b-bb47-7bc967379e76

	measure 'Qtd tabulações' =
			
			CALCULATE(
			    COUNTROWS(Atendimentos),
			    KEEPFILTERS(Atendimentos[Resultado do Contato] <> BLANK()),
			    USERELATIONSHIP( dCalendario[Date], Atendimentos[Data Modificação])
			)
		formatString: 0
		lineageTag: 769c3244-4b91-43f0-96ed-617496476eb2

	measure 'Qtd Atendimentos' =
			
			CALCULATE(
			    COUNTROWS(Atendimentos),
			    USERELATIONSHIP(Atendimentos[Data Modificação], dCalendario[Date])
			)
		formatString: 0
		lineageTag: 93620f8c-6a35-4bdf-895d-81b78e33e8b5

	measure '% Tabulação' =
			
			DIVIDE(
			    [Qtd tabulações],
			    [Qtd Atendimentos]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1e3b6c-3d44-42b7-91fd-39265522c5ce

	measure 'Média Aging' = ```
			
			VAR MediaCalculada = 
			    INT(
			        CALCULATE(
			            AVERAGE('Leads'[Aging Matrícula]),
			            CROSSFILTER('Leads'[ID Lead], 'Atendimentos'[Id Lead], BOTH)
			        )
			    )
			RETURN
			IF(ISBLANK(MediaCalculada), BLANK(), MediaCalculada & " dias")
			
			```
		lineageTag: 80bdab73-c902-4a6e-999b-9ad9503c17dd

	measure Media_Movel_7_Dias = ```
			
			CALCULATE(
			    [Média Aging],
			    DATESINPERIOD(
			        'dCalendario'[Date], 
			        LASTDATE('dCalendario'[Date]), 
			        -7, 
			        DAY
			    )
			)
			
			```
		lineageTag: d917ed7a-17ac-4d66-8a79-d206b911b941

	measure Aging_RelacionamentoOculto = ```
			
