	measure 'última tabulacao' = ```
			
			
			VAR UltimoRegistro =
			    TOPN(
			        1,
			        CALCULATETABLE(
			            'Atendimentos',
			            'Atendimentos'[Assunto] <> "Alteração em Massa",
			            NOT ISBLANK('Atendimentos'[Assunto])
			        
			        ),
			        'Atendimentos'[Data de Criação], DESC
			    )
			RETURN
			    CALCULATE(
			        SELECTEDVALUE('Atendimentos'[Resultado do Contato]),
			        UltimoRegistro
			    )
			```
		lineageTag: d6129c4c-f29e-4899-95c4-866f665f6ae5

	measure 'Atendimentos (Proprietário)' = ```
			
			VAR Proprietario =
			    SELECTEDVALUE('2026-2'[Proprietário Lead])
			
			RETURN
			CALCULATE(
			    COUNTROWS(Atendimentos),
			    USERELATIONSHIP(
			        Atendimentos[Data de Criação],
			        'dCalendario'[Date]
			    ),
			    FILTER(
			        Atendimentos,
			        CONTAINSSTRING(
			            LOWER(Atendimentos[Criado por]),
			            LOWER(Proprietario)
			        )
			    )
			)
			
			
			```
		formatString: 0
		lineageTag: 8129f827-26c2-44e4-be31-6dce2876b637

	measure 'Atendimentos (geral)' =
			
			CALCULATE(
			    COUNTROWS('Atendimentos'),
