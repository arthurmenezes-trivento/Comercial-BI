table Medidas
	lineageTag: 4419056a-db71-48c1-bdbb-d01910b4e999

	measure UltimoAtendente = ```
			
			
			-- 1. Captura o contexto do cliente/aluno da linha atual do visual
			VAR ClienteAtual = SELECTEDVALUE('2026-2'[Nome Completo]) 
			
			-- 2. Busca o último registro garantindo que pertence ao cliente da linha
			VAR UltimoRegistro =
			    TOPN(
			        1,
			        CALCULATETABLE(
			            'Atendimentos',
			            'Atendimentos'[Nome do Lead] = ClienteAtual, -- Altere para a coluna de relacionamento correta (ex: ID ou Nome)
			            'Atendimentos'[Assunto] <> "Alteração em Massa",
			            NOT ISBLANK('Atendimentos'[Assunto])
			        ),
			        'Atendimentos'[Data de Criação], DESC
			    )
			
			-- 3. Busca o nome do atendente
			VAR Resultado = 
			    CALCULATE(
			        SELECTEDVALUE('Atendimentos'[Criado por]),
			        UltimoRegistro
			    )
			
			RETURN
			    -- 4. Se o cliente for válido mas não tiver atendente, retorna o texto sem quebrar os filtros
			    IF(
			        NOT ISBLANK(ClienteAtual),
			        IF(ISBLANK(Resultado), "Sem Atendente", Resultado),
			        BLANK()
			    )
			
			```
		lineageTag: c2990e0a-0c93-4df1-848b-3acbcbe83565

	measure UltimaDataHoraCriacaoProprietario =
			
			VAR NomeCompleto =
			    TRIM(
			        LOWER(
			            COALESCE(
			                SELECTEDVALUE('2026-2'[Proprietário Lead]),
			                ""
			            )
			        )
			    )
			
			VAR PosicaoEspaco =
			    SEARCH(" ", NomeCompleto, 1, 0)
			
			VAR NomeProprietario =
			    IF(
			        PosicaoEspaco > 0,
			        LEFT(NomeCompleto, PosicaoEspaco - 1),
			        NomeCompleto
			    )
			
			VAR DataHoraMaxima =
			    CALCULATE(
			        MAXX(
			            Atendimentos,
			            Atendimentos[Data de Criação] + Atendimentos[Hora de Criação]
			        ),
			        SEARCH(
			            NomeProprietario,
			            TRIM(LOWER(Atendimentos[Criado por])),
			            1,
			            0
			        ) > 0
			    )
			
			RETURN
			IF(
			    NomeProprietario = "",
			    BLANK(),
			    FORMAT(DataHoraMaxima, "dd/MM/yyyy HH:mm")
			)
		lineageTag: 694999aa-e88d-4256-bce6-46893fa0a8d7

	measure 'Dias Sem Atendimento' = ```
			
			VAR TabelaFiltrada = 
			    FILTER(
			        'Atendimentos',
			        'Atendimentos'[Assunto] <> "Alteração em Massa" && 
			        NOT ISBLANK('Atendimentos'[Assunto])
			    )
			
			-- 1. Encontra a data e hora do último atendimento combinado
			VAR UltimoAtendimentoDT = 
			    CALCULATE(
			        MAXX(
			            TOPN(1, 'Atendimentos', 'Atendimentos'[Data de Criação], DESC, 'Atendimentos'[hora de Criação], DESC),
			            'Atendimentos'[Data de Criação] + 'Atendimentos'[Hora de Criação]
			        ),
			        TabelaFiltrada
			    )
			
			-- 2. Define o momento atual (pode usar UTCNOW() se seus dados forem em UTC)
			VAR DataAtual = NOW()
			
			-- 3. Calcula a diferença em dias (com casas decimais para precisão)
			VAR DiferencaDias = 
			    IF(
			        NOT ISBLANK(UltimoAtendimentoDT),
			        DATEDIFF(UltimoAtendimentoDT, DataAtual, DAY)
			    )
			
			RETURN
			    DiferencaDias
			
			```
		formatString: 0
		lineageTag: cfaacc72-d562-4ae0-99f6-f065b7b88504

	measure 'Matr 26-2' = ```
			
			    CALCULATE(
			        DISTINCTCOUNT('2026-2'[ID Lead]),
			        '2026-2'[Situação Inscrição] = "Matriculado",
			        '2026-2'[Data de Pagamento] <> BLANK(),
			        CROSSFILTER('2026-2'[ID Lead], Atendimentos[Id Lead], Both),
			        USERELATIONSHIP(dCalendario[Date], '2026-2'[Data de Pagamento])
			    )
			```
		formatString: 0
		lineageTag: 776476a4-d45f-4e8b-bb47-7bc967379e76

	measure 'Qtd tabulações' =
			
			CALCULATE(
			    COUNTROWS(Atendimentos),
			    KEEPFILTERS(Atendimentos[Resultado do Contato] <> BLANK()),
			    USERELATIONSHIP( dCalendario[Date], Atendimentos[Data Modificação])
			)
		formatString: 0
		lineageTag: 769c3244-4b91-43f0-96ed-617496476eb2

	measure '% Tabulação' =
			
			DIVIDE(
			    [Qtd tabulações],
