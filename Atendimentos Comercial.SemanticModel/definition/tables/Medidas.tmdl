	measure 'Leads 26-2 Acumulado' =
			
			VAR DataAtual = MAX(dCalendario[Date])
			
			RETURN
			IF(
			    DataAtual > TODAY(),
			    BLANK(),
			    CALCULATE(
			        DISTINCTCOUNT('2026-2'[ID Lead]),
			        '2026-2'[Situacao Funil] = "Potencial",
			        REMOVEFILTERS(dCurso[Curso Unidade]),
			        FILTER(
			            ALL(dCalendario[Date]),
			            dCalendario[Date] <= DataAtual
			        )
			    )
			    +
			    CALCULATE(
			        [Funil - Insc 26-2],
			        FILTER(
			            ALL(dCalendario[Date]),
			            dCalendario[Date] <= DataAtual
			        )
			    )
			)
		formatString: 0
		lineageTag: 0c08606a-b9d6-4480-8bbc-7088fa3b01f5

