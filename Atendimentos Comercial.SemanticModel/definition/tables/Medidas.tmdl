			)
		formatString: 0
		lineageTag: a33e22a6-279c-410a-976d-ffb6b7bc3e8d

	measure 'Data Último Atendimento' = ```
			
			CALCULATE(
			    CONVERT(MAX('Atendimentos'[Data de Criação]), DATETIME) + CONVERT(MAX('Atendimentos'[Hora de Criação]), DATETIME),
			    ALL('Atendimentos'[Id Lead]), // Substitua pelo nome exato da coluna que está no seu filtro
			    'Atendimentos'[Assunto] <> "Alteração em Massa",
			    NOT ISBLANK('Atendimentos'[Assunto])
			    
			)
			
			```
		formatString: General Date
		lineageTag: 776d8749-a672-4b35-bab0-ead263973162

