		lineageTag: 7a1e3b6c-3d44-42b7-91fd-39265522c5ce

	measure 'Média Aging' = ```
			
			VAR MediaCalculada = 
			    INT(
			        CALCULATE(
			            AVERAGE('2026-2'[Aging Matricula]),
			            CROSSFILTER('2026-2'[ID Lead], 'Atendimentos'[Id Lead], BOTH)
			        )
			    )
			RETURN
			IF(ISBLANK(MediaCalculada), BLANK(), MediaCalculada)
			
			```
		lineageTag: 80bdab73-c902-4a6e-999b-9ad9503c17dd

	measure Media_Movel_7_Dias = ```
			
			CALCULATE(
			    [Média Aging],
			    DATESINPERIOD(
			        'dCalendario'[Date], 
			        LASTDATE('dCalendario'[Date]), 
			        -7, 
			        DAY
			    )
			)
			
			```
		lineageTag: d917ed7a-17ac-4d66-8a79-d206b911b941

