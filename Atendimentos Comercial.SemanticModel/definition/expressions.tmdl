expression Leads =
		let
		    Token = #"Token de acesso"(),
		    url = "https://trivento.api.crmeducacional.com/api/LocalizacaoAvancada",
		
		body =
		"<fetch version=""1.0"" output-format=""xml-platform"" mapping=""logical"">#(lf)#(lf)  <entity name=""lead"">#(lf)#(lf)    <attribute name=""trivento_tabulacaojafoirealizada""/>#(lf)#(lf) <attribute name=""crmeduc_ultimatabulacao""/>#(lf)#(lf)   <attribute name=""fullname""/>#(lf)#(lf)   <attribute name=""cad_cpf""/>#(lf)#(lf)    <attribute name=""firstname""/>#(lf)#(lf)    <attribute name=""lastname""/>#(lf)#(lf)    <attribute name=""emailaddress1""/>#(lf)#(lf)    <attribute name=""mobilephone""/>#(lf)#(lf)    <attribute name=""telephone1""/>#(lf)#(lf)    <attribute name=""leadid""/>#(lf)#(lf)    <attribute name=""createdon""/>#(lf)#(lf)    <attribute name=""address1_city""/>#(lf)#(lf)    <attribute name=""address1_composite""/>#(lf)#(lf)    <attribute name=""address1_country""/>#(lf)#(lf)    <attribute name=""address1_county""/>#(lf)#(lf)    <attribute name=""address1_line1""/>#(lf)#(lf)    <attribute name=""address1_line2""/>#(lf)#(lf)    <attribute name=""address1_line3""/>#(lf)#(lf)    <attribute name=""address1_postalcode""/>#(lf)#(lf)    <attribute name=""address1_stateorprovince""/>#(lf)#(lf)    <attribute name=""cad_nacionalidade""/>#(lf)#(lf)    <attribute name=""cad_orgaoexpedidor""/>#(lf)#(lf)    <attribute name=""cad_rg""/>#(lf)#(lf)    <attribute name=""crmeduc_unidadeform""/>#(lf)#(lf)    <attribute name=""crmeduc_detalhamentotabulacao""/>#(lf)#(lf)    <attribute name=""crmeduc_idade""/>#(lf)#(lf)    <attribute name=""cad_dataaceitelgpd""/>#(lf)#(lf)    <attribute name=""cad_dataalteracaocadastrooferta""/>#(lf)#(lf)    <attribute name=""cad_concursoatual""/>#(lf)#(lf)    <attribute name=""cad_concursodeorigem""/>#(lf)#(lf)    <attribute name=""cad_datanascimento""/>#(lf)#(lf)    <attribute name=""cad_inscricaoatual""/>#(lf)#(lf)    <attribute name=""cad_ofertaatual""/>#(lf)#(lf)    <attribute name=""cad_situacaofunil""/>#(lf)#(lf)    <attribute name=""cad_corraca""/>#(lf)#(lf)    <attribute name=""cad_origemleadid""/>#(lf)#(lf)    <attribute name=""cad_proprietariopro""/>#(lf)#(lf)    <attribute name=""crmeduc_canal""/>#(lf)#(lf)    <attribute name=""crmeduc_unidade""/>#(lf)#(lf)    <attribute name=""crmeduc_tabulacaodolead""/>#(lf)#(lf)    <attribute name=""leadsourcecode""/>#(lf)#(lf)    <attribute name=""new_sexo""/>#(lf)#(lf)    <attribute name=""trivento_linhadenegociostrivento""/>#(lf)#(lf)#(lf)    <attribute name=""cad_estadocivil""/>#(lf)#(lf)#(lf)    <attribute name=""cad_campaigncontent""/>#(lf)#(cr)#(lf)#(lf)    <attribute name=""cad_campaignmedium""/>#(lf)#(cr)#(lf)#(lf)    <attribute name=""cad_campaignname""/>#(lf)#(cr)#(lf)#(lf)    <attribute name=""cad_campaignsource""/>#(lf)#(cr)#(lf)#(lf)    <attribute name=""cad_campaignterm""/>#(lf)    #(cr)#(lf)  <attribute name=""address1_addressid""/>#(lf)#(cr)#(lf)#(lf)    <attribute name=""cad_browser""/>#(lf)    <attribute name=""address2_addressid""/>#(lf)#(cr)#(lf)#(cr)#(lf)#(cr)#(lf)<order attribute=""createdon"" descending=""true""/>#(lf)#(lf)  </entity>#(lf)#(lf)</fetch>",
		
		
		    // FUNÇÃO QUE BUSCA UMA PÁGINA
		    GetPage = (Pagina as number) =>
		        let
		            Fonte =
		                Web.Contents(
		                    url,
		                    [
		                        Headers = [
		                            Authorization = "Bearer " & Token,
		                            #"Content-Type" = "application/xml",
		                            Pagina = Text.From(Pagina)
		                        ],
		                        Content = Text.ToBinary(body)
		                    ]
		                ),
		
		            XmlConvertido = Xml.Tables(Fonte),
		
		            Resultados =
		                try XmlConvertido{0}[result] otherwise null,
		
		            MoreRecords =
		                try XmlConvertido{0}[morerecords] otherwise "0"
		
		        in
		            [
		                Data = Resultados,
		                More = MoreRecords
		            ],
		
		    // LOOP AUTOMÁTICO
		    Paginas =
		        List.Generate(
		            () => [Pg = 1, Resultado = GetPage(1)],
		            each [Resultado][Data] <> null,
		            each [
		                Pg = [Pg] + 1,
		                Resultado = GetPage([Pg])
		            ],
		            each [Resultado][Data]
		        ),
		
		    // JUNTA TODAS AS PÁGINAS
		    TabelaFinal = Table.Combine(
		    List.Transform(
		        Paginas,
		        each Table.PrefixColumns(_, "result")
		    )
		),
