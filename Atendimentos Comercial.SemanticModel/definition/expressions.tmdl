	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

expression 'Token de acesso' =
		() =>
		let
		    url = "https://trivento.api.crmeducacional.com/api/token",
		
		    body =
		        Text.ToBinary(
		            "grant_type=password" &
		            "&username=IntegraçãoCRM" &
		            "&password=IntegraçãoCRM" &
		            "&authentication_type=APICRMEducacional"
		        ),
		
		    response =
		        Web.Contents(
		            url,
		            [
		                Headers = [
		                    #"Content-Type" = "application/x-www-form-urlencoded"
		                ],
		                Content = body
		            ]
		        ),
		
		    json = Json.Document(response),
		    access_token = json[access_token]
		in
		    access_token
	lineageTag: 5dc72585-7d98-40d8-89ee-b5b16a54957b
	queryGroup: 'Consultas - Token'

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Function

expression Inscricoes =
		let
		    Token = #"Token de acesso"(),
		
		    url = "https://trivento.api.crmeducacional.com/api/LocalizacaoAvancada",
		
		    body =
		"<fetch version=""1.0"" output-format=""xml-platform"" mapping=""logical"" distinct=""true"">#(lf)  <entity name=""cad_inscricaocandidato"" all-attributes=""true"">#(lf)    <order attribute=""createdon"" descending=""true""/>#(lf)  </entity>#(lf)</fetch>",
		    GetPage = (Pagina as number) =>
		        let
		            Fonte =
		                Web.Contents(
		                    url,
		                    [
		                        Headers = [
		                            Authorization = "Bearer " & Token,
		                            #"Content-Type" = "application/xml",
		                            Pagina = Text.From(Pagina)
		                        ],
		                        Content = Text.ToBinary(body)
		                    ]
		                ),
		
		            XmlConvertido = Xml.Tables(Fonte),
		
		            Resultados =
		                try XmlConvertido{0}[result] otherwise null,
		
		            MoreRecords =
		                try XmlConvertido{0}[morerecords] otherwise "0"
		
		        in
		            [
		                Data = Resultados,
		                More = MoreRecords
		            ],
		    Paginas = List.Generate(
		            () => [Pg = 1, Resultado = GetPage(1)],
		            each [Resultado][Data] <> null,
		            each [
		                Pg = [Pg] + 1,
		                Resultado = GetPage([Pg])
		            ],
		            each [Resultado][Data]
		        ),
		    tabela_final = Table.Combine(
		    List.Transform(
		        Paginas,
		        each Table.PrefixColumns(_, "result")
		    )
		),
		    #"result.crmeduc_data_aprovacao Expandido" = Table.ExpandTableColumn(tabela_final, "result.crmeduc_data_aprovacao", {"Attribute:date"}, {"Attribute:date"}),
		    #"Colunas Renomeadas2" = Table.RenameColumns(#"result.crmeduc_data_aprovacao Expandido",{{"Attribute:date", "Data Aprovação"}}),
		    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Colunas Renomeadas2",{{"Data Aprovação", type date}}),
		    #"result.cad_datapagamento Expandido" = Table.ExpandTableColumn(#"Tipo Alterado2", "result.cad_datapagamento", {"Attribute:date"}, {"Attribute:date"}),
		    #"Colunas Renomeadas" = Table.RenameColumns(#"result.cad_datapagamento Expandido",{{"Attribute:date", "Data de Pagamento"}}),
		    #"Tipo Alterado" = Table.TransformColumnTypes(#"Colunas Renomeadas",{{"Data de Pagamento", type date}}),
		    #"result.cad_situacaoavaliacao Expandido" = Table.ExpandTableColumn(#"Tipo Alterado", "result.cad_situacaoavaliacao", {"Attribute:name"}, {"Attribute:name"}),
		    #"Colunas Renomeadas1" = Table.RenameColumns(#"result.cad_situacaoavaliacao Expandido",{{"Attribute:name", "Situação de Avaliação"}}),
		    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Colunas Renomeadas1",{{"Situação de Avaliação", type text}}),
		    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado1",{"result.cad_barcodebase64", "result.cad_qrcodeinscricao"}),
		    #"result.cad_situacao Expandido" = Table.ExpandTableColumn(#"Colunas Removidas", "result.cad_situacao", {"Attribute:name"}, {"Attribute:name"}),
		    #"Colunas Renomeadas3" = Table.RenameColumns(#"result.cad_situacao Expandido",{{"Attribute:name", "Situação Inscrição"}}),
		    #"Tipo Alterado3" = Table.TransformColumnTypes(#"Colunas Renomeadas3",{{"Situação Inscrição", type text}}),
		    #"result.cad_ofertaid Expandido" = Table.ExpandTableColumn(#"Tipo Alterado3", "result.cad_ofertaid", {"Attribute:name"}, {"Attribute:name"}),
		    #"Colunas Renomeadas4" = Table.RenameColumns(#"result.cad_ofertaid Expandido",{{"Attribute:name", "Curso ID"}}),
		    #"Tipo Alterado4" = Table.TransformColumnTypes(#"Colunas Renomeadas4",{{"Curso ID", type text}}),
		    #"result.trivento_unidadedeensinotrivento Expandido" = Table.ExpandTableColumn(#"Tipo Alterado4", "result.trivento_unidadedeensinotrivento", {"Attribute:name"}, {"Attribute:name"}),
		    #"Colunas Renomeadas5" = Table.RenameColumns(#"result.trivento_unidadedeensinotrivento Expandido",{{"Attribute:name", "Unidade Inscrito"}}),
