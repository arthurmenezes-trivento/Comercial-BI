expression 'Token de acesso' =
		() =>
		let
		    url = "https://trivento.api.crmeducacional.com/api/token",
		
		    body =
		        Text.ToBinary(
		            "grant_type=password" &
		            "&username=IntegraçãoCRM" &
		            "&password=IntegraçãoCRM" &
		            "&authentication_type=APICRMEducacional"
		        ),
		
		    response =
		        Web.Contents(
		            url,
		            [
		                Headers = [
		                    #"Content-Type" = "application/x-www-form-urlencoded"
		                ],
		                Content = body
		            ]
		        ),
		
		    json = Json.Document(response),
		    access_token = json[access_token]
		in
		    access_token
	lineageTag: 5dc72585-7d98-40d8-89ee-b5b16a54957b
	queryGroup: 'Consultas - Token'

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Function

expression Consulta1 =
		let
		
		    Token = #"Token de acesso"(),
		
		    url = "https://trivento.api.crmeducacional.com/api/LocalizacaoAvancada",
		
		    body =
		"<fetch version=""1.0"" output-format=""xml-platform"" mapping=""logical"">
		  <entity name=""lead"" all-attributes=""true"">
		    <order attribute=""createdon"" descending=""true""/>
		  </entity>
		</fetch>",
		
		
		    // FUNÇÃO QUE BUSCA UMA PÁGINA
		    GetPage = (Pagina as number) =>
		        let
		            Fonte =
		                Web.Contents(
		                    url,
		                    [
		                        Headers = [
		                            Authorization = "Bearer " & Token,
		                            #"Content-Type" = "application/xml",
		                            Pagina = Text.From(Pagina)
		                        ],
		                        Content = Text.ToBinary(body)
		                    ]
		                ),
		
		            XmlConvertido = Xml.Tables(Fonte),
		
		            Resultados =
		                try XmlConvertido{0}[result] otherwise null,
		
		            MoreRecords =
		                try XmlConvertido{0}[morerecords] otherwise "0"
		
		        in
		            [
		                Data = Resultados,
		                More = MoreRecords
		            ],
		
		    // LOOP AUTOMÁTICO
		    Paginas =
		        List.Generate(
		            () => [Pg = 1, Resultado = GetPage(1)],
		            each [Resultado][Data] <> null,
		            each [
		                Pg = [Pg] + 1,
		                Resultado = GetPage([Pg])
		            ],
		            each [Resultado][Data]
		        ),
		
		    // JUNTA TODAS AS PÁGINAS
		    TabelaFinal = Table.Combine(Paginas)
		
		in
		    TabelaFinal
	lineageTag: 444837b5-afb7-4fd7-bfb3-4130e4f6c13f
	queryGroup: 'Consultas - Token'

